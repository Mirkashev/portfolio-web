---
import styles from './About.module.scss';
import Typography from '@/shared/ui/Typography/Typography';
---

<section class={styles.root}>
  <Typography type='h2'>About Me</Typography>
  <div class={styles.content}>
    <div class={styles.description}>
      <Typography type='p'>
        Over 4 years of experience in frontend development. I work with a modern
        tech stack: HTML, CSS, JavaScript, TypeScript, React, Next.js, React
        Native, Redux, Zustand, and Mobx. I have participated in over 30
        projects successfully deployed to production.
      </Typography>
    </div>
    <div class={styles.accordion}>
      {/* Accordion components will be added here in the future */}
      <Typography type='p'>Accordion placeholder</Typography>
    </div>
  </div>
</section>
